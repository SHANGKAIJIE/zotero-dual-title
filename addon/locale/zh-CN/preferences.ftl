# Dual Title — 偏好设置本地化 (简体中文)
pref-section-basic = 双行标题设置
pref-enable-dual-title =
    .label = 启用双行标题显示
pref-display-mode = 标题内容：
pref-display-mode-original =
    .label = 仅原标题
pref-display-mode-translated =
    .label = 仅翻译标题
pref-display-mode-original-translated =
    .label = 原标题 ＋ 翻译标题
pref-display-mode-original-remark =
    .label = 原标题 ＋ 简记
pref-title-order = 标题顺序：
pref-title-order-original-first =
    .label = 原标题在上，副标题在下
pref-title-order-subtitle-first =
    .label = 副标题在上，原标题在下
pref-auto-translate =
    .label = 新条目自动翻译
pref-font-size = 副标题字号：
pref-font-size-unit = px
pref-font-color = 副标题颜色：
pref-font-color-reset = 恢复默认
pref-subtitle-font-weight = 副标题字重：
pref-subtitle-font-weight-normal =
    .label = 常规
pref-subtitle-font-weight-bold =
    .label = 加粗
pref-gap = 标题间距：
pref-gap-unit = px
pref-row-height = 主条目行高：
pref-row-height-unit = 倍
pref-child-row-height = 下属条目行高：
pref-child-row-height-follow =
    .label = 跟随主条目改变
pref-child-row-height-keep =
    .label = 保持不变

pref-help = Dual Title v{ $version } ({ $time })
